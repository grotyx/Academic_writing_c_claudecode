# OS generated files
.DS_Store

# Local settings
.claude/settings.local.json
.vscode/

# Presentation files (not part of manuscript workflow)
# Promo videos, thumbnails and upload text (large, local only)
/promo/
presentation/

# Personal profile (author info, contacts, funding).
# Use profile/* (not profile/) so the example_ templates below can be re-included:
# git cannot un-ignore a file whose parent directory itself is excluded.
profile/*
!profile/example_authors.md
!profile/example_journals.md

# Superpowers planning/spec notes — internal, not for public release
docs/superpowers/

# Local DOCX style references may contain private reviewer-response text
Author_response_220803_Final.docx

# Root-level generated submission artifacts belong under output/ or output/revision/
/manuscript_*.docx
/response_letter_*.docx
/title_page_*.docx
/table_*.docx

# Reference PDFs — copyright-protected, do not commit
knowledge/pdf/

# Style anchor PDFs — copyright-protected, local only
Style/PDF/**/*.pdf
Style/PDF/**/*.PDF

# Learned style profiles hold measured numbers and model paragraphs quoted from the learned papers
# (copyright-protected, local only); pending rules hold wording from the author's drafts.
Style/profile/
**/Style/profile/
Style/pending_style_rules.md

# Style anchor markdown files may contain private/local analysis context
Style/own/*.md
!Style/own/example_*.md
Style/landmark/*.md
Style/target_journal/*.md
!Style/style_guide.md
!Style/terminology.md

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Local archives/backups (not part of the workflow)
*.zip

# Private project work and credentials (already tracked templates are unaffected)
.env
.env.*
!.env.example
.venv/
/results/
/output/
/review/runs/
/review/packets/
/review/state.json
/review/*.json
/review/*.jsonl
/data/*.csv
/data/*.xlsx
/data/*.xls
/data/*.approval.json
/drafts/*.approval.json
/project.json
